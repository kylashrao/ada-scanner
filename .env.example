# Canonical production origin, including https://. Used by metadata, robots.txt
# and sitemap.xml. If unset, use Vercel's VERCEL_PROJECT_PRODUCTION_URL
# (enable automatic System Environment Variables). Local fallback is
# http://localhost:3000. Do not use a preview deployment URL here.
NEXT_PUBLIC_SITE_URL=

# Public operator/controller name and monitored editorial/privacy inbox.
# Both values are shown on the site. Set both before public launch.
SITE_OPERATOR=
SITE_CONTACT_EMAIL=

# Optional Google AdSense. The publisher ID is already configured and must
# match public/ads.txt. Leave disabled until Google approves the site, the
# applicable Privacy & messaging setup is live, and Auto ads are off.
ADSENSE_ENABLED=false
# Numeric ID of the fixed 250 × 250 display unit used on editorial guides.
ADSENSE_GUIDE_SLOT=
